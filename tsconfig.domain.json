{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".domain-build",
    "rootDir": "src",
    "lib": [
      "ES2020"
    ],
    "noEmitOnError": true
  },
  "include": [
    "src/domain/**/*",
    "src/data/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
